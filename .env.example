# Database. Host-run (non-Docker) backend: localhost. docker-compose overrides these inside containers.
POSTGRES_USER=injury_user
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=injury_detection
# Host-side Postgres port. Default 5432; set POSTGRES_PORT=5433 (and point DATABASE_URL at it) if something already owns 5432.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://injury_user:changeme_in_production@localhost:5432/injury_detection

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Google OAuth2 (get from Google Cloud Console). Secrets live ONLY in your local .env, never in git.
# In the Google console, add GOOGLE_REDIRECT_URI below as an "Authorized redirect URI" (exact match).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Where the backend sends the browser after Google sign-in (the Next.js app).
FRONTEND_URL=http://localhost:3000

# Auth cookies are httpOnly + SameSite=Lax + Secure. Chrome/Firefox accept Secure cookies on
# http://localhost ONLY (not on http://127.0.0.1 or a LAN address): open the app as localhost, or set false.
COOKIE_SECURE=true

# Backend
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Storage
USE_S3_STORAGE=false
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@injury-detection.local

# --- Speed (video analysis) --------------------------------------------------------------------------------------
# Pose runs on every frame. The person-detector (YOLO) only has to find and follow the athlete, so it runs on a
# smaller image and ~15 times a second; boxes in between are interpolated. Raise these only if the athlete is small
# or far from the camera (YOLO_IMGSZ=640, YOLO_TRACK_FPS=0 = every frame: the old, ~5x slower behaviour).
YOLO_IMGSZ=384
YOLO_TRACK_FPS=15
# MediaPipe pose model: lite (fastest) | full (default, more accurate) | heavy. Changing it changes the numbers,
# so do not mix videos analysed with different models in one comparison group.
POSE_LANDMARKER_VARIANT=full

# --- AI engine: reference-population floors -------------------------------------------------
# A video is only scored against a population of OTHER completed videos of the same movement type.
# Both floors must be met or the API answers 202 "baseline building" instead of inventing a score.
# Lower them for demos only; every response reports how many baseline videos/athletes were used.
MIN_BASELINE_VIDEOS=10
MIN_BASELINE_ATHLETES=3
