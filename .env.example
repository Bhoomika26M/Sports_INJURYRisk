# Database
POSTGRES_USER=injury_user
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=injury_detection
# Host-side Postgres port. Default 5432; set POSTGRES_PORT=5433 in your local
# .env (and point DATABASE_URL at it) if something already occupies 5432.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://injury_user:changeme_in_production@postgres:5432/injury_detection

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Google OAuth2 (get from Google Cloud Console). Secrets live ONLY in your local .env, never in git.
# In the Google console, add GOOGLE_REDIRECT_URI below as an "Authorized redirect URI" (exact match).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Where the backend sends the browser after Google sign-in (the Next.js app).
FRONTEND_URL=http://localhost:3000

# Auth cookies are httpOnly + SameSite=Lax + Secure. Chrome/Firefox accept Secure cookies on
# http://localhost; set false ONLY for a browser that does not (e.g. Safari) during local development.
COOKIE_SECURE=true

# Backend
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Storage
USE_S3_STORAGE=false
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@injury-detection.local

# Pose Landmarker Model (auto-downloaded if not present)
POSE_LANDMARKER_MODEL_PATH=pose_landmarker_lite.task