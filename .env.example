# PostgreSQL Configuration
POSTGRES_USER=sports_user
POSTGRES_PASSWORD=sports_password
POSTGRES_DB=sports_injury_risk

# Backend Configuration
DATABASE_URL=postgresql://sports_user:sports_password@localhost:5432/sports_injury_risk
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password OTP (recovery + authenticated password change)
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Recommended in production; if empty a distinct key is HKDF-derived from SECRET_KEY.
OTP_HMAC_SECRET=

# Google Sign-In (OAuth 2.0 authorization-code flow)
# Create an OAuth 2.0 Client ID (Web application) in the Google Cloud console,
# then paste the credentials here. Leave blank to keep the feature disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Where the browser lands after success/failure.
GOOGLE_FRONTEND_SUCCESS_REDIRECT=http://localhost:5173/dashboard
GOOGLE_FRONTEND_FAILURE_REDIRECT=http://localhost:5173/login

# Analysis performance
# Pose sampling rate (detection runs per sampled frame - the main speed lever).
POSE_FPS=15
# Parallel MediaPipe instances. 0 = auto.
POSE_WORKERS=0
# Downscale frames wider than this before person detection (roughly halves
# detection cost on 4K; person boxes are scale-invariant). 0 disables.
DETECT_MAX_WIDTH=1280
DETECT_IMGSZ=640
# Crop the annotated output to follow the athlete so the full body fills frame.
ANNOTATED_FOLLOW_ATHLETE=true
ANNOTATED_CROP_PADDING=0.55
ANNOTATED_CROP_SMOOTHING=0.25
ANNOTATED_CROP_MIN_SCALE=0.35
# Log a per-stage timing breakdown per analysis. Off unless investigating perf.
POSE_PROFILING=false

# Frontend Configuration
VITE_API_URL=http://localhost:8000
