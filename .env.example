# Copy to .env and edit. Never commit the real .env.
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# First administrator, created on startup if it does not exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Optional Google OAuth2 login (client ID from Google Cloud console)
GOOGLE_CLIENT_ID=

# Postgres (used by docker-compose)
POSTGRES_USER=injury
POSTGRES_PASSWORD=injury_pw
POSTGRES_DB=injury_risk

RATE_LIMIT_PER_MINUTE=240
MAX_UPLOAD_MB=500
