    footwear: Optional[str] = None
    rpe: Optional[int] = None
    sleep_quality: Optional[int] = None
    risk_score: float
    risk_level: str
    injury_probabilities: str
    corrective_recommendation: str
    created_at: str
    class Config:
        from_attributes = True
