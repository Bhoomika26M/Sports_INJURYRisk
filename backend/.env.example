# Kinematix Platform Configuration Example
# Copy this file to .env and configure for your local or production environment

# Application Settings
PROJECT_NAME="Kinematix - Sports Injury Risk Platform"
PROJECT_VERSION="1.0.0"

# Database Configuration (PostgreSQL is the specified production primary database)
# For local SQLite development:
# DATABASE_URL=sqlite:///sports_injury.db
# For production PostgreSQL:
DATABASE_URL=postgresql://kinematix_user:kinematix_secret_password@localhost:5432/kinematix

# Security & Authentication (JWT sessions and SHA-256 tokens)
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SMTP Email Configuration for Secure Password Reset Flow
# When configured, single-use 15-minute reset links are dispatched to users via SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=api_key_or_smtp_user
SMTP_PASSWORD=smtp_password_secret
SMTP_FROM=noreply@kinematix.app

# Frontend URL (Used for constructing password reset links in emails)
FRONTEND_URL=http://localhost:3000

