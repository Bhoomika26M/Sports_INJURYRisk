DATABASE_URL=postgresql://user:password@localhost:5432/sports_injury_risk
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Configuration (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@sportsinjuryrisk.com

# Environment
ENVIRONMENT=development

# --- Password OTP (recovery + authenticated password change) ---
# Number of digits in an emailed one-time code (default 6).
OTP_LENGTH=6
# How long an issued code stays valid, in minutes (default 5).
OTP_EXPIRE_MINUTES=5
# Maximum verification attempts per issued code before it is locked (default 5).
OTP_MAX_ATTEMPTS=5
# Minimum seconds between issuing codes for the same account/purpose (default 60).
OTP_RESEND_COOLDOWN_SECONDS=60
# Dedicated key used to HMAC-hash OTPs at rest. RECOMMENDED in production and
# rotated independently of SECRET_KEY. If left empty, a distinct key is derived
# from SECRET_KEY via HKDF (domain separated) so the OTP key is never a naive
# reuse of SECRET_KEY.
OTP_HMAC_SECRET=

# --- Google Sign-In (OAuth 2.0 authorization-code flow) ---
# Create an OAuth 2.0 Client ID (type: Web application) in the Google Cloud
# console and paste the values here. The feature stays disabled (503) until
# both GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" registered on the client.
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Where the browser is sent after the server-side redirect callback.
GOOGLE_FRONTEND_SUCCESS_REDIRECT=http://localhost:5173/dashboard
GOOGLE_FRONTEND_FAILURE_REDIRECT=http://localhost:5173/login

# --- Analysis performance ---
# Pose sampling rate. Detection runs per sampled frame, so this is the single
# most effective speed lever: 15 -> 8 roughly halves analysis time, at the cost
# of fewer samples for the movement/risk calculations.
POSE_FPS=15
# Parallel MediaPipe pose instances. 0 = auto (min(4, cpu_count)).
POSE_WORKERS=0
# Frames wider than this are downscaled before person detection. A person box
# is scale-invariant, so this is nearly free accuracy-wise but roughly halves
# detection cost on 4K footage. 0 disables the downscale.
DETECT_MAX_WIDTH=1280
# YOLO inference size. Ultralytics' default is 640.
DETECT_IMGSZ=640
# Annotated output framing: crop to a window that follows the athlete so the
# full body fills the frame instead of appearing as a small figure.
ANNOTATED_FOLLOW_ATHLETE=true
ANNOTATED_CROP_PADDING=0.55
ANNOTATED_CROP_SMOOTHING=0.25
ANNOTATED_CROP_MIN_SCALE=0.35

# --- Diagnostics ---
# Log a per-stage timing breakdown at the end of each analysis (where the time
# actually went). Off by default; leave off unless investigating performance.
POSE_PROFILING=false
