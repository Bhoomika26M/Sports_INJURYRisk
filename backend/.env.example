# Backend Database Settings (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=sports_injury_db

# Security & JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-replace-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]

# Google OAuth 2.0 / OpenID Connect Settings
# Obtain Client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional: Admin Registration Secret Code
ADMIN_REGISTRATION_CODE=admin-secret-access-token-change-in-production
